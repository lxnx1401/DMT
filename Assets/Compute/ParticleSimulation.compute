#pragma kernel CSMain

struct Particle
{
    float2 position;
    float2 velocity;
    float2 offset;
    float damping;
    float forceScale;
};

RWStructuredBuffer<Particle> particles;
StructuredBuffer<float2> mouseHistory;
StructuredBuffer<float> mouseSpeedHistory;

uint particleCount;
uint historyCount;

float time;
float deltaTime;
float mouseSpeed;

float tangentialStiffness;
float lateralStiffness;
float trailWidth;
float idleWidth;
float tailTaper;
float wanderStrength;
float stretchResponse;
float maxSpeed;
uint substeps;

float minSpeed;
float maxSpeed2;

float neighborRadius;
float preferredDistance;
float cohesionStrength;
float separationStrength;

struct Obstacle
{
    float2 position;
    float radius;
};

StructuredBuffer<Obstacle> obstacles;
uint obstacleCount;

float hash11(float p)
{
    p = frac(p * 0.1031);
    p *= p + 33.33;
    p *= p + p;
    return frac(p);
}

float sampleSpeedHistory(float t)
{
    float f = t * (float)(historyCount - 1);
    uint i0 = (uint)floor(f);
    uint i1 = min(i0 + 1u, historyCount - 1u);
    float frac_ = f - (float)i0;
    return lerp(mouseSpeedHistory[i0], mouseSpeedHistory[i1], frac_);
}

float2 sampleHistory(float t)
{
    float f = t * (float)(historyCount - 1);
    uint i0 = (uint)floor(f);
    uint i1 = min(i0 + 1u, historyCount - 1u);
    float frac_ = f - (float)i0;
    return lerp(mouseHistory[i0], mouseHistory[i1], frac_);
}

[numthreads(256,1,1)]
void CSMain(uint3 id : SV_DispatchThreadID)
{
    uint index = id.x;
    if (index >= particleCount) return;

    Particle p = particles[index];

    float seedA = hash11(index * 12.9898);
    float seedB = hash11(index * 78.233 + 1.0);
    float seedC = hash11(index * 45.164 + 2.0);
    float lateralSeed = seedC * 2.0 - 1.0;

    float trailT = pow(seedA, 1.6);
    float2 pathPoint = sampleHistory(trailT);
    float localSpeed = sampleSpeedHistory(trailT);

    float2 pathVec = mouseHistory[0] - mouseHistory[historyCount - 1];
    float pathLen = length(pathVec);
    float2 pathDir = pathLen > 0.001 ? pathVec / pathLen : float2(1.0, 0.0);
    float2 perp = float2(-pathDir.y, pathDir.x);

    float freqX = lerp(0.2, 0.5, seedA);
    float freqY = lerp(0.2, 0.5, seedB);
    float2 wander = float2(
        sin(time * freqX + seedA * 6.2831),
        sin(time * freqY + seedB * 6.2831)
    ) * wanderStrength;

    float stretch = smoothstep(minSpeed, maxSpeed2, localSpeed);

    float2 isoOffset = p.offset * idleWidth;

    float taper = lerp(1.0, tailTaper, trailT);
    float2 dirOffset = perp * lateralSeed * trailWidth * taper;

    float2 lateral = lerp(isoOffset, dirOffset, stretch);
    float2 target = pathPoint + lateral + wander;

    float2 localForce = float2(0.0, 0.0);
    uint neighborCount = 0;
    for (uint j = 0; j < particleCount; j++)
    {
        if (j == index)
            continue;

        Particle neighbor = particles[j];

        float2 delta = neighbor.position - p.position;
        float dist = length(delta);

        if (dist < 0.0001 || dist > neighborRadius)
            continue;

        float2 dir = delta / dist;

        float distanceError = dist - preferredDistance;

        localForce += dir * distanceError;
        neighborCount++;
    }
    if (neighborCount > 0)
        localForce /= (float)neighborCount;

    float subDt = deltaTime / (float)substeps;
    for (uint s = 0; s < substeps; s++)
    {
        float2 diff = target - p.position;

        float along = dot(diff, pathDir);
        float across = dot(diff, perp);

        float2 pathForce =
            (pathDir * along * tangentialStiffness
            + perp * across * lateralStiffness)
            * p.forceScale;

        float2 force =
            pathForce
            + localForce * cohesionStrength;

        p.velocity += force * subDt;
        p.velocity *= pow(p.damping, subDt * 60.0);

        float speed = length(p.velocity);
        if (speed > maxSpeed)
            p.velocity = p.velocity / speed * maxSpeed;

        float2 prevPos = p.position;  
        p.position += p.velocity * subDt;

        // Kollision NACH der Bewegung auflösen
        
        float bounciness = 1.6; // >1 = übertriebener, knalliger Bounce; 1.0 = "normaler" Abprall; 0 = alte Version (nur stoppen)
        float pushOutForce = 40.0; // zusätzlicher Schubs nach außen, damit's nicht "klebt"

        for (uint i = 0; i < obstacleCount; i++)
        {
            Obstacle o = obstacles[i];

            float2 toObstacle = o.position - prevPos;
            float2 moveVec = p.position - prevPos;
            float moveLen = length(moveVec);
            float2 moveDir = moveLen > 0.0001 ? moveVec / moveLen : float2(0, 0);

            float proj = clamp(dot(toObstacle, moveDir), 0.0, moveLen);
            float2 closestPoint = prevPos + moveDir * proj;

            float2 delta = closestPoint - o.position;
            float dist = length(delta);

            if (dist < o.radius)
            {
                float2 normal = dist > 0.0001 ? delta / dist : float2(1, 0);

                p.position = o.position + normal * (o.radius * 1.001);

                float vn = dot(p.velocity, normal);
                if (vn < 0)
                    p.velocity -= normal * vn * (1.0 + bounciness); // Reflexion statt nur Stoppen

                // Zusätzlicher Impuls nach außen, damit es "knallt" statt nur abgleitet
                p.velocity += normal * pushOutForce * subDt;
            }
        }
    }

    particles[index] = p;
}