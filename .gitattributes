# Git LFS tracking for large binary media assets.
# Existing files already committed to history are NOT retroactively migrated
# by this alone — see Issue "Large media files tracked directly in Git without LFS"
# for the (separate, history-rewriting) migration step.

*.mp4 filter=lfs diff=lfs merge=lfs -text
*.mov filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.ogg filter=lfs diff=lfs merge=lfs -text
*.aiff filter=lfs diff=lfs merge=lfs -text
